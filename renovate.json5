{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/\\.yaml$/',
    ],
  },
  // The flux manager defaults to **/gotk-components.yaml only, which left every
  // HelmRelease chart version unmanaged. Widen it like the kubernetes manager above so
  // chart bumps are raised too; repo-wide matching also lets Renovate resolve a
  // HelmRelease's sourceRef to a HelmRepository declared in a different directory.
  flux: {
    managerFilePatterns: [
      '/\\.yaml$/',
    ],
  },
  pinDigests: true,
  minimumReleaseAge: '3 days',
  semanticCommitType: 'fix',
  // Default is 2/hour, which throttles a single daily run hard enough that most
  // dependencies queue for days behind whichever branches happen to process first.
  prHourlyLimit: 10,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/infrastructure/k3s-upgrade-plans/plans\\.yaml/',
      ],
      matchStrings: [
        'version: (?<currentValue>v[^\\n]+)',
      ],
      depNameTemplate: 'k3s-io/k3s',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$',
    },
    {
      // gh is installed from a GitHub release .deb, not apt, so no built-in manager
      // sees ARG GH_VERSION. Track it against cli/cli releases (tagged vX.Y.Z; the
      // ARG holds the bare version, hence extractVersionTemplate).
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)runner/Dockerfile$/',
      ],
      matchStrings: [
        'ARG GH_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'cli/cli',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // KubeVirt's virt-operator starts the other components itself, so their images are
      // plain env strings in a kustomize patch, which no built-in manager reads. Track
      // them here: the virt-* core images move with the operator image in the 'kubevirt'
      // group; virt-template-* follows its own capped line (packageRules below).
      customType: 'regex',
      managerFilePatterns: [
        '/infrastructure/controllers/base/kubevirt/kustomization\\.yaml$/',
      ],
      matchStrings: [
        'value: (?<depName>quay\\.io/kubevirt/virt-[a-z-]+):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      // config:best-practices pulls in :semanticPrefixFixDepsChoreOthers, whose
      // packageRules set semanticCommitType per-dependency and override our top-level
      // 'fix' default above. That preset only maps npm's 'dependencies'/'require'
      // depTypes (and Maven) to 'fix'; Docker deps get depType 'stage'/'final' and fall
      // through to its catch-all 'chore' rule. Our own rule here is applied after the
      // preset's and wins, so Docker image/tag/digest bumps land as fix(deps) too.
      matchDatasources: [
        'docker',
      ],
      semanticCommitType: 'fix',
      // The Docker datasource only gets a releaseTimestamp from Docker Hub's
      // tag_last_pushed field; every other registry (ghcr.io included) never gets one.
      // minimumReleaseAgeBehaviour defaults to 'timestamp-required', which treats a
      // missing timestamp as permanently pending -- so with minimumReleaseAge set
      // below, every non-Docker-Hub image (all our ghcr.io/* deps) silently never got
      // its first branch/PR created, no matter how old the release actually was.
      // 'timestamp-optional' keeps the age gate where Renovate can actually check it
      // (Docker Hub) and lets everything else through immediately instead of hanging
      // forever.
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      matchPackageNames: [
        'ghcr.io/milanoid-labs/homelab-runner',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      automerge: false,
    },
    {
      // Automerge minor and patch bumps once all checks are green. Renovate flips
      // GitHub's native auto-merge (platformAutomerge defaults to true and "Allow
      // auto-merge" is enabled on the repo), so GitHub merges in real time as gates
      // pass -- important because the self-hosted CronJob runs only once a day and
      // Renovate-performed merges are capped at one PR per target branch per run.
      // matchCurrentVersion excludes pre-1.0 deps: semver allows 0.x to break on a
      // "minor", so those stay manual. The pattern must account for our prefixed tag
      // schemes (backend-v0.x.y / frontend-v0.x.y) and optional leading 'v' -- a bare
      // !/^0/ would let those through. Digest-only bumps are type 'digest' and stay
      // governed by the two rules above; first-time pin PRs are type 'pin' and never
      // match here.
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchCurrentVersion: '!/^(.*-)?v?0\\./',
      automerge: true,
    },
    {
      matchManagers: [
        'flux',
      ],
      pinDigests: false,
    },
    {
      // The ARC controller and the runner scale set share a version and must move
      // together, so keep them in a single PR. The flux manager picks them up natively
      // from the oci-type HelmRepository in arc-controller/repository.yaml.
      matchManagers: [
        'flux',
      ],
      matchPackageNames: [
        'ghcr.io/actions/actions-runner-controller-charts/**',
      ],
      groupName: 'arc',
    },
    {
      // argo-workflows is referenced by two kustomize git refs (crds/minimal and
      // cluster-install-no-crds). They must move together or CRDs and controller end up
      // on mismatched versions, so group them into a single PR.
      matchManagers: ['kustomize'],
      matchPackageNames: ['argoproj/argo-workflows'],
      groupName: 'argo-workflows',
      // v3.x clears the pre-1.0 guard, but Argo has a history of breaking minor
      // upgrades (controller/CRD/webhook behavior changes), so keep bumps manual.
      // Must stay after the broad minor/patch automerge rule to win on rule order.
      automerge: false,
    },
    {
      // spec.version in the k3s upgrade Plans is the single source of truth for the
      // k3s release. system-upgrade-controller derives the upgrade image tag from it
      // (CRD: "Image name. If the tag is omitted, the value from .status.latestVersion
      // will be used"), so this is the only k3s dependency Renovate should manage.
      matchManagers: ['custom.regex'],
      matchPackageNames: ['k3s-io/k3s'],
      pinDigests: false,
      groupName: 'k3s upgrade',
      // A k3s bump triggers a node upgrade via system-upgrade-controller (control-plane
      // reboots included), so even a semver 'patch' here is a cluster event -- keep it
      // manual. Must stay after the broad minor/patch automerge rule to win on rule order.
      automerge: false,
    },
    {
      // Same reason as the docker rule above: :semanticPrefixFixDepsChoreOthers would
      // otherwise label this chore(deps). A gh bump changes the runner image, so it's a fix.
      matchManagers: ['custom.regex'],
      matchPackageNames: ['cli/cli'],
      semanticCommitType: 'fix',
    },
    {
      // The runner image is only built by build-runner-image.yml, which is not a
      // required check in the ruleset, so GitHub's native auto-merge would not wait
      // for it. dirmngr is pinned to the base image's gpgconf, so a base bump can
      // break the build. Let Renovate merge these itself instead: it only does so
      // once every check on the branch, including the image build, is green.
      matchFileNames: ['runner/Dockerfile'],
      platformAutomerge: false,
    },
    {
      // spec.upgrade.image is deliberately left untagged so the tag follows
      // spec.version. Renovate must not touch it: adding a tag or a pinned digest
      // (pinDigests is true globally) would break that derivation and let the image
      // drift out of step with spec.version -- which silently no-ops the upgrade.
      matchManagers: ['kubernetes'],
      matchPackageNames: ['rancher/k3s-upgrade'],
      enabled: false,
    },
    {
      // kubevirt-operator.yaml is a vendored release asset; its tag-only image line must
      // stay as upstream ships it (the real pin is in kustomization.yaml). Without this,
      // pinDigests would edit the vendored file.
      matchManagers: ['kubernetes'],
      matchPackageNames: ['quay.io/kubevirt/**'],
      enabled: false,
    },
    {
      // A KubeVirt upgrade is the operator image (kustomize images:) plus six v1.x
      // component digests (custom.regex above) plus the vendored manifest. One PR, merged
      // by hand. The images inherit distroless's source label, so point Renovate at the
      // real repo for release notes.
      matchPackageNames: ['quay.io/kubevirt/**', '!quay.io/kubevirt/virt-template-*'],
      groupName: 'kubevirt',
      sourceUrl: 'https://github.com/kubevirt/kubevirt',
      automerge: false,
      prBodyNotes: [
        '⚠️ Before merging: replace `infrastructure/controllers/base/kubevirt/kubevirt-operator.yaml` with the new release asset, update the digest-only `VIRT_OPERATOR_IMAGE` in the patch, and check the k8s support matrix (kubevirt/sig-release). On a new minor, also move the virt-template-* images and the `allowedVersions` cap in renovate.json5 to the minor that release pins in `hack/virt-template/default.sh`.',
      ],
    },
    {
      // virt-template-* is on its own v0.x line, and each KubeVirt release pins one minor
      // of it (v1.9 -> 0.2, v1.10 -> 0.3). The operator applies that minor's
      // CRDs/RBAC/webhooks and only swaps the images, so cap the images to it. Without the
      // cap Renovate proposed v0.3.0 for the v1.9.1 operator (#692) and skipped v0.2.4.
      // Raise it together with the operator's minor.
      matchPackageNames: ['quay.io/kubevirt/virt-template-*'],
      allowedVersions: '<0.3.0',
      groupName: 'virt-template',
      sourceUrl: 'https://github.com/kubevirt/virt-template',
      automerge: false,
      prBodyNotes: [
        '⚠️ virt-template is deployed by virt-operator, which applies the manifests of the minor its release pins. Check the version matches `hack/virt-template/default.sh` on the KubeVirt release branch in use.',
      ],
    },
    {
      // gotk-components.yaml is a generated Flux bundle: each controller image is built
      // against the CRDs shipped beside it. The kubernetes manager (widened to every *.yaml
      // above) bumped single controller images without the CRDs, and #761 crashlooped
      // notification-controller v1.10.0 on CRDs that didn't serve its v1 kinds (#764).
      // Stop the kubernetes manager's version bumps here; Flux versions move only through
      // the flux manager's fluxcd/flux2 PR below, which regenerates the whole bundle.
      // Digest pins stay on: the flux manager writes tag-only images, and the kubernetes
      // manager's pin PR (#791) is what restores the digests after a regen.
      matchManagers: ['kubernetes'],
      matchFileNames: ['**/gotk-components.yaml'],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      enabled: false,
    },
    {
      // A Flux release changes CRDs, RBAC and all four controllers at once (#788), so it is
      // a control-plane upgrade even on a semver 'minor'. Keep it manual. Must stay after
      // the broad minor/patch automerge rule to win on rule order.
      matchManagers: ['flux'],
      matchPackageNames: ['fluxcd/flux2'],
      automerge: false,
      prBodyNotes: [
        '⚠️ Flux control-plane upgrade. Check the release notes for removed API versions: CRDs that drop a version still listed in `status.storedVersions` fail to apply until the objects are migrated (`flux migrate`). After merging, merge the follow-up digest pin PR for the controller images.',
      ],
    },
    {
      // system-upgrade-controller is vendored as two release assets, crd.yaml and
      // controller.yaml, but Renovate only sees the image in controller.yaml, so a bump
      // leaves the Plan CRD behind (#338, #428 and #561 never touched it). Same failure
      // mode as the Flux bundle above, so keep these bumps manual.
      matchManagers: ['kubernetes'],
      matchPackageNames: ['rancher/system-upgrade-controller'],
      automerge: false,
      prBodyNotes: [
        '⚠️ Before merging: replace `infrastructure/controllers/base/system-upgrade-controller/crd.yaml` (and `controller.yaml`, if upstream changed RBAC or flags) with this release\'s assets from rancher/system-upgrade-controller.',
      ],
    },
    {
      matchPackageNames: [
        'renovate/renovate',
      ],
      schedule: [
        'before 9am on monday',
      ],
      automerge: true,
    },
    {
      versioning: 'regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?$',
      matchPackageNames: [
        '/^ghcr\\.io/hotio//',
      ],
    },
    {
      // linuxserver/qbittorrent carries years of legacy tag formats (date-stamped,
      // arch-prefixed, bare build numbers like "113") alongside current bare-semver
      // releases. 'loose' versioning parsed those stray numeric tags as comparable
      // semver and proposed a 2019 tag as "newer" than the 2021 tag in use (#529).
      // Constrain to the real release shape so only actual semver tags are considered.
      matchPackageNames: [
        'linuxserver/qbittorrent',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      // home-dashboard's images are tagged "backend-vX.Y.Z" / "frontend-vX.Y.Z"
      // (release-please's include-component-in-tag) and study-app-api uses
      // "backend-vX.Y.Z" too. Not bare semver, so the default docker versioning
      // can't parse them and silently never reports an update (same issue
      // already fixed above for ghcr.io/hotio/*).
      versioning: 'regex:^(backend|frontend)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      matchPackageNames: [
        'ghcr.io/milanoid-labs/home-dashboard-api',
        'ghcr.io/milanoid-labs/home-dashboard-web',
        'ghcr.io/milanoid-labs/study-app-api',
      ],
    },
    {
      // The kubevirt-scaleset scaler is tagged YYYYMMDD-<sha7> (its scaler.yaml workflow).
      // Default docker versioning reads the -<sha7> as a compatibility suffix and only
      // compares tags with the same suffix, so a new build (new sha) never matched and
      // the pin never moved. Parse the date as the version instead; the sha is ignored.
      // Two builds on the same day compare equal, so the later one waits for the next day.
      matchPackageNames: [
        'ghcr.io/milanoid-labs/kubevirt-scaleset',
      ],
      versioning: 'regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})-[0-9a-f]{7}$',
    },
  ],
}
